  node [shape=ellipse, style="filled", fillcolor="#EEF3F8", color="#4A6A8A"];
  u1 [label="Registrarse y aceptar\ntratamiento de datos"]; u2 [label="Publicar oferta semanal"]; u3 [label="Actualizar cantidad\no retirar oferta"]; u4 [label="Consultar reservas\nde su puesto"];
