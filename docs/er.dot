graph ER { rankdir=LR; fontname="Helvetica"; node [shape=plaintext, fontname="Helvetica", fontsize=10]; edge [fontname="Helvetica", fontsize=10, color="#4A6A8A"];
 Usuario [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#4A6A8A"><font color="white"><b>USUARIO</b></font></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">nombre</td></tr><tr><td align="left">telefono (único)</td></tr><tr><td align="left">rol (CLIENTE, PRODUCTOR, SECRETARIA, ADMIN)</td></tr><tr><td align="left">hash_contrasena</td></tr><tr><td align="left">acepta_tratamiento_datos</td></tr><tr><td align="left">fecha_autorizacion</td></tr></table>>];
 Vereda [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#4A6A8A"><font color="white"><b>VEREDA</b></font></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">nombre</td></tr></table>>];
 Productor [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#4A6A8A"><font color="white"><b>PRODUCTOR</b></font></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">FK id_usuario</td></tr><tr><td align="left">FK id_vereda</td></tr><tr><td align="left">numero_puesto</td></tr><tr><td align="left">acepta_nequi</td></tr></table>>];
 Producto [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#4A6A8A"><font color="white"><b>PRODUCTO</b></font></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">nombre</td></tr><tr><td align="left">categoria</td></tr></table>>];
 Jornada [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#4A6A8A"><font color="white"><b>JORNADA_MERCADO</b></font></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">fecha_sabado</td></tr><tr><td align="left">cierre_reservas</td></tr><tr><td align="left">estado</td></tr></table>>];
 Oferta [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#4A6A8A"><font color="white"><b>OFERTA</b></font></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">FK id_productor</td></tr><tr><td align="left">FK id_producto</td></tr><tr><td align="left">FK id_jornada</td></tr><tr><td align="left">cantidad_ofertada</td></tr><tr><td align="left">cantidad_disponible</td></tr><tr><td align="left">precio</td></tr><tr><td align="left">unidad</td></tr><tr><td align="left">version (bloqueo optimista)</td></tr></table>>];
 Reserva [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#4A6A8A"><font color="white"><b>RESERVA</b></font></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">FK id_cliente (usuario)</td></tr><tr><td align="left">FK id_jornada</td></tr><tr><td align="left">fecha_creacion</td></tr><tr><td align="left">estado (ACTIVA, ENTREGADA, CANCELADA, NO_RECOGIDA)</td></tr><tr><td align="left">codigo_recogida</td></tr></table>>];
 Detalle [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#4A6A8A"><font color="white"><b>DETALLE_RESERVA</b></font></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">FK id_reserva</td></tr><tr><td align="left">FK id_oferta</td></tr><tr><td align="left">cantidad</td></tr><tr><td align="left">precio_unitario</td></tr><tr><td align="left">medio_pago (EFECTIVO, NEQUI)</td></tr></table>>];
 Usuario -- Productor [label="1 : 0..1"]; Vereda -- Productor [label="1 : N"]; Productor -- Oferta [label="1 : N"]; Producto -- Oferta [label="1 : N"]; Jornada -- Oferta [label="1 : N"]; Usuario -- Reserva [label="1 : N"]; Jornada -- Reserva [label="1 : N"]; Reserva -- Detalle [label="1 : N"]; Oferta -- Detalle [label="1 : N"];
}
